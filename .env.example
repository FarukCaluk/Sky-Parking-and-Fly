# Optional. Inbox that receives the reservations sent from the form (delivered through formsubmit.co).
# Defaults to a test address in src/data/site.ts; set the business address when going live.
# The owner of the inbox must click the activation link FormSubmit sends after the first reservation.
VITE_RESERVATION_EMAIL=

# Optional. Public origin written into sitemap.xml, canonical URLs and social cards at build time.
# Defaults to the Vercel production URL; set it when you attach a custom domain, e.g. https://parkingandfly.ba
SITE_URL=

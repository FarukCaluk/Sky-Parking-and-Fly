# Optional. When set, reservations are POSTed as JSON to this endpoint.
# When empty, reservations are stored locally (demo gateway).
VITE_BOOKING_ENDPOINT=

# Optional. NextFrame-style snapshot source for live camera feeds.
# `{camera}` is replaced with the camera id (entrance, covered-a, open-b, shuttle).
# Example: https://cams.example.com/frames/{camera}/latest.jpg
VITE_NEXTFRAME_URL=

# Optional. Poll interval for NextFrame snapshots in milliseconds (default 1500).
VITE_NEXTFRAME_INTERVAL_MS=1500

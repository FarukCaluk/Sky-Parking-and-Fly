# --- Reservations ------------------------------------------------------------------------------------------------
# The reservation form posts to /api/reservation (api/reservation.ts), which mails the reservation to us and mails the
# confirmation (reservation code, dates, price, rules) to the guest, in the language the guest used on the site.
# Set these in the Vercel project (Settings > Environment Variables) and, to try it locally, in .env.local.
# Without SMTP settings the form still works: the reservation reaches the inbox through formsubmit.co and the guest
# sees the confirmation on the page only.

# The mailbox that sends, for example the mailbox of info@parkingandfly.ba (ask the hosting provider for these).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender shown to the guest, e.g. "Sky Parking & Fly" <info@parkingandfly.ba>. Defaults to SMTP_USER.
SMTP_FROM=
# Optional address the guest's replies go to. Defaults to RESERVATION_EMAIL.
SMTP_REPLY_TO=

# Where our copy of every reservation goes. Defaults to booking@parkingandfly.ba.
RESERVATION_EMAIL=

# Try it without sending anything: 1 writes both mails to .mail-preview/ instead of sending them.
MAIL_DRY_RUN=

# Same inbox for the fallback form service (build time, optional).
VITE_RESERVATION_EMAIL=

# --- Site --------------------------------------------------------------------------------------------------------
# Optional. Public origin written into sitemap.xml, canonical URLs and social cards at build time.
# Defaults to the Vercel production URL; set it when you attach a custom domain, e.g. https://parkingandfly.ba
SITE_URL=

# Optional. Google Tag Manager container (build time), e.g. GTM-XXXXXXX. Set it only on the live domain, so that tests on
# other addresses do not count as visits or conversions. It is loaded after the first paint.
GTM_ID=

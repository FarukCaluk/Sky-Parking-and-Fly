      "permanent": true
    },
    {
      "source": "/o-nama",
      "destination": "/objekat",
      "permanent": true
    },
    {
      "source": "/en/o-nama",
      "destination": "/en/facilities",
      "permanent": true
    },
    {
      "source": "/de/o-nama",
      "destination": "/de/einrichtungen",
      "permanent": true
    },
    {
      "source": "/cjenovnik",
      "destination": "/cijene",
      "permanent": true
    },
    {
      "source": "/en/cjenovnik",
      "destination": "/en/pricing",
      "permanent": true
    },
    {
      "source": "/de/cjenovnik",
      "destination": "/de/preise",
      "permanent": true
    },
    {
      "source": "/rezervacije",

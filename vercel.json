      "permanent": true
    },
    {
      "source": "/en/rezervacije",
      "destination": "/en/reservation",
      "permanent": true
    },
    {
      "source": "/de/rezervacije",
      "destination": "/de/reservierung",
      "permanent": true
    },
    {
      "source": "/lokacija",
      "destination": "/kontakt",
      "permanent": true
    },
    {
      "source": "/en/lokacija",
      "destination": "/en/contact",
      "permanent": true
    },
    {
      "source": "/de/lokacija",
      "destination": "/de/kontakt",
      "permanent": true

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/reservation.ts": {
      "includeFiles": "src/**/*.ts"
    }
  },
  "redirects": [
    {
      "source": "/en/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/de/",
      "destination": "/de",
      "permanent": true
    },
    {
      "source": "/pocetna",
      "destination": "/",
      "permanent": true

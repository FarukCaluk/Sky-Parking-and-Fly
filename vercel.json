      "destination": "/en/airport-transfer-step-by-step",
      "permanent": true
    },
    {
      "source": "/de/transfer-do-aerodroma-korak-po-korak",
      "destination": "/de/transfer-zum-flughafen-schritt-fuer-schritt",
      "permanent": true
    },
    {
      "source": "/en/dugo-parkiranje-bez-brige-11-20-i-21-dana",
      "destination": "/en/long-term-parking-without-worries-11-20-and-21-days",
      "permanent": true
    },
    {
      "source": "/de/dugo-parkiranje-bez-brige-11-20-i-21-dana",
      "destination": "/de/langzeitparken-ohne-sorgen-11-20-und-21-tage",
      "permanent": true
    },
    {
      "source": "/recenzije/:slug",
      "destination": "/recenzije",
      "permanent": true
    },
    {
      "source": "/en/recenzije/:slug",
      "destination": "/en/reviews",
      "permanent": true
    },
    {
      "source": "/de/recenzije/:slug",
      "destination": "/de/bewertungen",
      "permanent": true
    },
    {
      "source": "/en/recenzije",
      "destination": "/en/reviews",
      "permanent": true
    },
    {
      "source": "/de/recenzije",
      "destination": "/de/bewertungen",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/novosti",
      "permanent": true
    },
    {
      "source": "/author/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
